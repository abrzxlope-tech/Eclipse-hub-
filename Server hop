local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local ServerHopModule = {}
ServerHopModule.__index = ServerHopModule

ServerHopModule.Settings = {
    LowPlayerServers = true,
    MaxPlayersFilter = 4,
    RegionFilter = "Global",
    AutoHopInterval = 300,
    NotificationSystem = true,
    AvoidDuplicates = true,
    TeleportRetries = 3
}

ServerHopModule.Stats = {
    ServersScanned = 0,
    HopsAttempted = 0,
    LastServerId = game.JobId,
    FailedAttempts = 0
}

local visitedServers = {}
visitedServers[game.JobId] = true

local function SendNotification(title, text)
    if not ServerHopModule.Settings.NotificationSystem then return end
    pcall(function()
        print("[Eclipse ServerHop Pro] " .. title .. ": " .. text)
    end)
end

-- [MOTOR DE CONSULTA AVANZADA DE INSTANCIAS DE ROBLOX API]
local function QueryRobloxServers(placeId, cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", placeId)
    if cursor then
        url = url .. "&cursor=" .. cursor
    end
    
    local success, response = pcall(function()
        return game:HttpGet(url)
    end)
    
    if success then
        local decodeSuccess, decoded = pcall(function()
            return HttpService:JSONDecode(response)
        end)
        if decodeSuccess then
            return decoded
        end
    end
    return nil
end

local function ExecuteAdvancedHop()
    pcall(function()
        SendNotification("Server Hop", "Escaneando red de servidores...")
        local placeId = game.PlaceId
        local cursor = nil
        local bestServer = nil
        
        ServerHopModule.Stats.HopsAttempted = ServerHopModule.Stats.HopsAttempted + 1

        for _ = 1, 3 do -- Intentar hasta 3 páginas de servidores si es necesario
            local data = QueryRobloxServers(placeId, cursor)
            if data and data.data then
                for _, server in ipairs(data.data) do
                    ServerHopModule.Stats.ServersScanned = ServerHopModule.Stats.ServersScanned + 1
                    if type(server) == "table" then
                        local serverId = server.id
                        local playing = server.playing or 0
                        local maxPlayers = server.maxPlayers or 0
                        
                        local isNotCurrent = (serverId ~= game.JobId)
                        local isNotVisited = not ServerHopModule.Settings.AvoidDuplicates or not visitedServers[serverId]
                        local meetsPlayerCriteria = playing < maxPlayers and playing <= ServerHopModule.Settings.MaxPlayersFilter
                        
                        if isNotCurrent and isNotVisited and meetsPlayerCriteria then
                            bestServer = serverId
                            break
                        end
                    end
                end
                
                if bestServer then break end
                cursor = data.nextPageCursor
                if not cursor then break end
            else
                break
            end
        end
        
        if bestServer then
            visitedServers[bestServer] = true
            ServerHopModule.Stats.LastServerId = bestServer
            SendNotification("Server Hop", "¡Servidor óptimo localizado! Saltando...")
            
            local successHop = false
            local attempts = 0
            while not successHop and attempts < ServerHopModule.Settings.TeleportRetries do
                attempts = attempts + 1
                local status = pcall(function()
                    TeleportService:TeleportToPlaceInstance(placeId, bestServer, LocalPlayer)
                end)
                if status then
                    successHop = true
                else
                    task.wait(1)
                end
            end
            
            if not successHop then
                ServerHopModule.Stats.FailedAttempts = ServerHopModule.Stats.FailedAttempts + 1
                TeleportService:Teleport(placeId, LocalPlayer)
            end
        else
            SendNotification("Server Hop", "No se encontró filtro estricto. Usando salto aleatorio...")
            TeleportService:Teleport(placeId, LocalPlayer)
        end
    end)
end

